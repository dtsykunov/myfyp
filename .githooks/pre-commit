#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] Running lint, type checks, and tests via Nix dev shell..."
nix develop --command sh -c "./cloudflare/worker/scripts/run-lint.sh && ./cloudflare/worker/scripts/run-typecheck.sh && ./cloudflare/worker/scripts/run-tests.sh"

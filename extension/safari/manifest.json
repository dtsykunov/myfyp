{
  "manifest_version": 3,
  "name": "myfyp",
  "description": "Share your personal YouTube recommendation page snapshot.",
  "version": "0.1.0",
  "homepage_url": "https://myfyp.link",
  "action": {
    "default_title": "myfyp",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://myfyp.link/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
